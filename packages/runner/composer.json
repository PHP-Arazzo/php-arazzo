{
    "name": "php-arazzo/arazzo-runner",
    "description": "Arazzo workflow execution engine: state, events, policy, protocol, async, telemetry.",
    "type": "library",
    "version": "1.0.0-alpha.1",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "php-arazzo/arazzo-contracts": "@dev",
        "php-arazzo/arazzo-document": "@dev",
        "php-arazzo/arazzo-engine": "@dev",
        "php-arazzo/arazzo-evaluation": "@dev",
        "php-arazzo/arazzo-expression": "@dev",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Alama\\Arazzo\\Runner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alama\\Arazzo\\Tests\\": "tests/",
            "Alama\\Arazzo\\Tests\\Events\\": "tests/Events/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "arazzo": {
            "plugins": [
                "src/Plugins/OperationExecutor"
            ]
        }
    }
}
