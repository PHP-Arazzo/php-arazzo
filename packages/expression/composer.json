{
    "name": "php-arazzo/arazzo-expression",
    "description": "Arazzo expression engine and criteria evaluation.",
    "type": "library",
    "version": "1.0.0-alpha.1",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "php-arazzo/arazzo-contracts": "@dev",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "softcreatr/jsonpath": "^0.10.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Alama\\Arazzo\\Expression\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alama\\Arazzo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "arazzo": {
            "plugins": [
                "Alama\\Arazzo\\Expression\\Plugins\\JsonPathSelectorPlugin",
                "Alama\\Arazzo\\Expression\\Plugins\\JsonPointerSelectorPlugin",
                "Alama\\Arazzo\\Expression\\Plugins\\XpathSelectorPlugin",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ActionOutputTargetExclusivityRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ExpressionContextMisuseRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ExpressionJsonPointerSyntaxRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ExpressionSyntaxRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ExpressionUnresolvedComponentRefRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ExpressionUnresolvedInputRefRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ExpressionUnresolvedSourceRefRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ExpressionUnresolvedStepRefRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\ExpressionUnresolvedWorkflowRefRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\JsonPathCriterionConditionRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\MessageRefRequiresReceiveRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\SelectorTypeSupportedRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\StepOperationPathSyntaxRule",
                "Alama\\Arazzo\\Expression\\Validation\\Rules\\SuccessCriteriaVersionSupportedRule"
            ]
        }
    }
}
